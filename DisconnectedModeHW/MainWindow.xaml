<Window x:Class="DisconnectedModeHW.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управління користувачами" Height="450" Width="800">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <DockPanel Grid.Column="0" Margin="0,0,10,0">
            <CheckBox x:Name="chkOnlyAdmins" Content="Показати лише адміністраторів" 
                      DockPanel.Dock="Top" Margin="0,0,0,10" Click="chkOnlyAdmins_Click"/>
            <DataGrid x:Name="dgUsers" AutoGenerateColumns="True" SelectionChanged="dgUsers_SelectionChanged"/>
        </DockPanel>

        <StackPanel Grid.Column="1">
            <TextBlock Text="Логін:"/>
            <TextBox x:Name="txtLogin" Margin="0,0,0,5"/>

            <TextBlock Text="Пароль:"/>
            <TextBox x:Name="txtPassword" Margin="0,0,0,5"/>

            <TextBlock Text="Адреса:"/>
            <TextBox x:Name="txtAddress" Margin="0,0,0,5"/>

            <TextBlock Text="Телефон:"/>
            <TextBox x:Name="txtPhone" Margin="0,0,0,5"/>

            <CheckBox x:Name="chkIsAdmin" Content="Адміністратор" Margin="0,5,0,15"/>

            <Button Content="Додати" Click="BtnAdd_Click" Margin="0,0,0,5" Height="30"/>
            <Button Content="Редагувати" Click="BtnEdit_Click" Margin="0,0,0,5" Height="30"/>
            <Button Content="Видалити" Click="BtnDelete_Click" Height="30"/>
        </StackPanel>
    </Grid>
</Window>
